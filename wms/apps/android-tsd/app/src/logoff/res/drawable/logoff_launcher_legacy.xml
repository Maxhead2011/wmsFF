<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="48dp" android:height="48dp" />
            <corners android:radius="11dp" />
            <solid android:color="@color/logoff_launcher_background" />
        </shape>
    </item>
    <item>
        <inset android:insetLeft="12%" android:insetTop="12%" android:insetRight="12%" android:insetBottom="12%">
            <bitmap android:src="@drawable/logoff_launcher_art" android:gravity="fill" android:filter="true" />
        </inset>
    </item>
</layer-list>
