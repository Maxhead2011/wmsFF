generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ClientStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ClientKind {
  LEGAL_ENTITY
  INDIVIDUAL_ENTREPRENEUR
  SELF_EMPLOYED
  INDIVIDUAL
}

enum ClientLogisticsInvoiceMode {
  SEPARATE
  SAME_INVOICE
  DISABLED
}

enum ClientStorageBillingMode {
  MONTHLY
  ON_SHIPMENT
}

enum ClientStockBalanceMode {
  PALLET_SORT
  BOXES
}

enum MarketplaceType {
  WILDBERRIES
  OZON
  YANDEX_MARKET
  SBER_MARKET
  OTHER
}

// ADDED: отдельный жизненный цикл юридически значимых операций в ГИС МТ.
enum KizCirculationOperation {
  RETIRE
  RETURN
}

enum KizCirculationItemStatus {
  NEEDS_REVIEW
  READY
  ALREADY_APPLIED
  IN_BATCH
  SUBMITTED
  APPLIED
  ERROR
  EXCLUDED
}

enum KizCirculationBatchStatus {
  DRAFT
  SIGNED
  SUBMITTED
  APPLIED
  REJECTED
}

enum ClientRequestType {
  INBOUND
  OUTBOUND
  RETURN
  DELIVERY
  SERVICE
  OTHER
}

enum ClientRequestStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  IN_WORK
  PACKED
  DONE
  CANCELLED
  REJECTED
}

enum ClientRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ClientRequestEventType {
  CREATED
  STATUS_CHANGED
  COMMENT
  FILE_UPLOADED
}

enum StockStatus {
  AVAILABLE
  IN_TRANSIT
  RESERVED
  RECEIVING
  PACKING
  SHIPPING
  BLOCKED
  DEFECT
  QUARANTINE
  UNMARKED
  NEEDS_LABEL
  NEEDS_RELABEL
}

enum InventorySessionType {
  FULL
  PARTIAL
  BOX_CHECK
}

enum InventorySessionStatus {
  ACTIVE
  REVIEW
  COMPLETED
  CANCELLED
}

enum InventoryBoxStatus {
  COUNTING
  MATCHED
  MISMATCH
  RESOLVED
}

enum InventoryLineDecision {
  PENDING
  APPLY_ACTUAL
  KEEP_SYSTEM
}

enum VolumeSource {
  MANUAL
  CALCULATED
  MARKETPLACE
  NOT_REQUIRED
}

enum MovementType {
  INITIAL_IMPORT
  RECEIPT
  MOVE
  RESERVE
  PICK
  PACK
  SHIP
  RETURN
  INVENTORY_ADJUSTMENT
}

enum WarehouseBoxCheckSeverity {
  HIGH
  MEDIUM
  LOW
}

enum WarehouseBoxCheckDecision {
  PENDING
  WRITE_OFF
  KEEP_AS_IS
  SET_QUANTITY
}

enum PickWaveStatus {
  PLANNED
  BALANCE_REVIEW
  FROZEN
  PICKING
  DONE
  FAILED
  CANCELLED
}

enum PickWaveBalanceReviewStatus {
  PENDING
  SUBMITTED
  APPROVED
  NOT_REQUIRED
}

enum PickWaveRequestStatus {
  PLANNED
  PICKED
  FAILED
}

enum TsdOperationStatus {
  ACCEPTED
  NEEDS_REVIEW
  REJECTED
}

enum TsdReviewAction {
  APPLY_INVENTORY_ADJUSTMENT
  REJECT
}

enum TsdReviewReason {
  INVENTORY_MISMATCH
  SKU_NOT_FOUND
  BOX_NOT_FOUND
  RECEIPT_FAILED
  DEVICE_MISMATCH
  VALIDATION_ERROR
  MANUAL_REJECT
  OTHER
}

enum TsdDeviceStatus {
  ACTIVE
  BLOCKED
}

enum LogisticsPricingMode {
  TOTAL
  PER_PALLET
  MANUAL_REVIEW
}

enum LogisticsDeliveryStatus {
  REQUESTED
  QUOTED
  PLANNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum LogisticsTripStatus {
  PLANNED
  LOADING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum BillingUnit {
  SERVICE
  PIECE
  BOX
  PALLET
  LITER
  LITER_DAY
  DAY
  HOUR
}

enum BillingChargeStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum BillingChargeSource {
  MANUAL
  STORAGE
  LOGISTICS
}

enum BillingInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum BillingInvoiceSource {
  MANUAL
  REQUEST_DONE
  LOGISTICS
}

enum BillingPriceTaxMode {
  INCLUDED
  ADD_6_PERCENT
}

enum BillingPaymentStatus {
  RECORDED
  CANCELLED
}

enum ExpenseCategory {
  MATERIALS
  LOGISTICS
  PAYROLL_PICKERS
  HANDLING_PPR
  CONTRACT_WORK
  RENT
  UTILITIES
  TAXES
  SOFTWARE
  EQUIPMENT
  MARKETING
  OTHER
}

enum ExpenseSource {
  MANUAL
  MATERIAL_PURCHASE
  AUTO_MATERIAL_CONSUMPTION
  MATERIAL_WRITE_OFF
  LOGISTICS
}

enum ExpenseStatus {
  ACTIVE
  CANCELLED
}

enum ExpenseMaterialMovementType {
  INITIAL
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
  WRITE_OFF
}

enum FbsDeliveryDestination {
  PICKUP_POINT
  VNUKOVO_SORTING_CENTER
}

enum LabelTemplateType {
  BOX
  SKU
  PALLET
  CUSTOM
}

enum ClientNotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum ClientNotificationEvent {
  REQUEST_COMMENT
  REQUEST_STATUS_CHANGED
  REQUEST_FILE_UPLOADED
  BILLING_INVOICE_STATUS_CHANGED
  BILLING_PAYMENT_RECORDED
  LOGISTICS_DELIVERY_STATUS_CHANGED
  SKU_EXPIRATION
  MANUAL
}

model User {
  id                             String                         @id @default(uuid())
  email                          String                         @unique
  passwordHash                   String
  tsdActivationCodeHash          String?
  name                           String
  status                         UserStatus                     @default(ACTIVE)
  isDemo                         Boolean                        @default(false)
  analyticsEnabled               Boolean                        @default(false)
  activeWarehouseId              String?
  activeWarehouse                Warehouse?                     @relation("ActiveWarehouse", fields: [activeWarehouseId], references: [id], onDelete: SetNull)
  warehouseScopes                UserWarehouse[]
  roles                          UserRole[]
  clientScopes                   UserClient[]
  printerScopes                  UserPrinterGroup[]
  sessions                       UserSession[]
  tsdDevices                     TsdDevice[]
  createdClientRequests          ClientRequest[]                @relation("ClientRequestCreatedBy")
  assignedClientRequests         ClientRequest[]                @relation("ClientRequestAssignedTo")
  reviewedTsdOperations          TsdOperation[]                 @relation("TsdOperationReviewedBy")
  createdBillingCharges          BillingCharge[]                @relation("BillingChargeCreatedBy")
  approvedBillingCharges         BillingCharge[]                @relation("BillingChargeApprovedBy")
  createdBillingInvoices         BillingInvoice[]               @relation("BillingInvoiceCreatedBy")
  createdBillingPayments         BillingPayment[]               @relation("BillingPaymentCreatedBy")
  updatedClientBillingServices   ClientBillingService[]         @relation("ClientBillingServiceUpdatedBy")
  createdDeliveries              LogisticsDeliveryRequest[]     @relation("LogisticsDeliveryCreatedBy")
  uploadedRequestFiles           ClientRequestFile[]            @relation("ClientRequestFileUploadedBy")
  createdRequestPackages         ClientRequestPackage[]         @relation("ClientRequestPackageCreatedBy")
  createdPickWaves               PickWave[]                     @relation("PickWaveCreatedBy")
  assignedPickWaves              PickWave[]                     @relation("PickWaveAssignedPicker")
  createdNotifications           ClientNotification[]           @relation("ClientNotificationCreatedBy")
  updatedNotificationPreferences ClientNotificationPreference[] @relation("ClientNotificationPreferenceUpdatedBy")
  authoredRequestComments        ClientRequestComment[]         @relation("ClientRequestCommentAuthor")
  createdRequestEvents           ClientRequestEvent[]           @relation("ClientRequestEventCreatedBy")
  createdClientContracts         ClientContract[]               @relation("ClientContractCreatedBy")
  uploadedSignedContracts        ClientContract[]               @relation("ClientContractSignedUploadedBy")
  uploadedContractAttachments    ClientContractAttachment[]     @relation("ClientContractAttachmentUploadedBy")
  assignedFulfillmentClients     Client[]                       @relation("ClientFulfillmentManager")
  referralClients                UserReferralClient[]           @relation("UserReferralAssignments")
  updatedReferralClients         UserReferralClient[]           @relation("UserReferralUpdatedBy")
  systemSettings                 SystemSetting[]
  auditLogs                      AuditLog[]
  createdExpenseEntries          ExpenseEntry[]                 @relation("ExpenseEntryCreatedBy")
  cancelledExpenseEntries        ExpenseEntry[]                 @relation("ExpenseEntryCancelledBy")
  updatedExpenseMaterialRules    ClientExpenseMaterialRule[]    @relation("ClientExpenseMaterialRuleUpdatedBy")
  createdExpenseMaterialMoves    ExpenseMaterialMovement[]      @relation("ExpenseMaterialMovementCreatedBy")
  mobileDevices                  MobileDevice[]
  mobileSessions                 MobileSession[]
  mobileCommands                 MobileCommand[]
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
}

model MobileDevice {
  id             String               @id @default(uuid())
  userId         String
  installationId String               @unique
  name           String?
  platform       String               @default("ANDROID")
  appVersion     String?
  fcmToken       String?              @unique
  isActive       Boolean              @default(true)
  lastSeenAt     DateTime             @default(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions       MobileSession[]
  pushDeliveries MobilePushDelivery[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId, isActive])
  @@index([lastSeenAt])
}

model MobilePushDelivery {
  id             String       @id @default(uuid())
  deviceId       String
  notificationId String
  status         String       @default("SENT")
  error          String?
  device         MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([deviceId, notificationId])
  @@index([notificationId])
}

model MobileSession {
  id               String       @id @default(uuid())
  userId           String
  deviceId         String
  refreshTokenHash String       @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime     @default(now())
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device           MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([userId, revokedAt, expiresAt])
  @@index([deviceId, revokedAt])
}

model MobileCommand {
  id             String   @id @default(uuid())
  userId         String
  idempotencyKey String
  action         String
  status         String   @default("COMPLETED")
  response       Json?
  expiresAt      DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([expiresAt])
}

model SystemSetting {
  key             String   @id
  value           Json
  updatedByUserId String?
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedByUserId])
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  code  String           @unique
  name  String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model UserClient {
  userId    String
  clientId  String
  canRead   Boolean  @default(true)
  canWrite  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  client    Client   @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, clientId])
  @@index([clientId])
}

model UserReferralClient {
  userId          String
  clientId        String
  percent         Decimal   @db.Decimal(5, 2)
  isActive        Boolean   @default(true)
  startsAt        DateTime  @default(now())
  expiresAt       DateTime?
  termMonths      Int?
  updatedByUserId String?
  user            User      @relation("UserReferralAssignments", fields: [userId], references: [id], onDelete: Cascade)
  client          Client    @relation(fields: [clientId], references: [id])
  updatedBy       User?     @relation("UserReferralUpdatedBy", fields: [updatedByUserId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@id([userId, clientId])
  @@index([clientId])
  @@index([updatedByUserId])
  @@index([isActive])
  @@index([expiresAt])
}

model UserPrinterGroup {
  userId    String
  groupCode String
  canPrint  Boolean  @default(true)
  canManage Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, groupCode])
  @@index([groupCode])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Client {
  id                           String                         @id @default(uuid())
  ownCompanyId                 String?
  code                         String                         @unique
  name                         String
  isDemo                       Boolean                        @default(false)
  clientKind                   ClientKind                     @default(LEGAL_ENTITY)
  legalName                    String?
  inn                          String?
  kpp                          String?
  ogrn                         String?
  legalAddress                 String?
  actualAddress                String?
  phone                        String?
  email                        String?
  telegramChatId               String?
  bankName                     String?
  bankBik                      String?
  bankAccount                  String?
  correspondentAccount         String?
  storageAccountingEnabled     Boolean                        @default(false)
  storagePriceRubPerLiterDay   Decimal?                       @db.Decimal(12, 4)
  logisticsInvoiceMode         ClientLogisticsInvoiceMode     @default(SEPARATE)
  storageBillingMode           ClientStorageBillingMode       @default(MONTHLY)
  storesWithoutBoxes           Boolean                        @default(false)
  stockBalanceMode             ClientStockBalanceMode         @default(PALLET_SORT)
  onlineReceiptVisibleToClient Boolean                        @default(false)
  fbsCalculatorEnabled         Boolean                        @default(false)
  relabelingEnabled            Boolean                        @default(false)
  factoryEnabled               Boolean                        @default(false)
  factoryName                  String?
  factoryCode                  String?                        @unique
  fulfillmentManagerUserId     String?
  status                       ClientStatus                   @default(ACTIVE)
  fulfillmentManager           User?                          @relation("ClientFulfillmentManager", fields: [fulfillmentManagerUserId], references: [id])
  ownCompany                   OwnCompany?                    @relation(fields: [ownCompanyId], references: [id], onDelete: SetNull)
  skus                         Sku[]
  boxes                        Box[]
  pallets                      Pallet[]
  storagePallets               StoragePallet[]
  movements                    StockMovement[]
  userScopes                   UserClient[]
  requests                     ClientRequest[]
  billingCharges               BillingCharge[]
  billingInvoices              BillingInvoice[]
  billingPayments              BillingPayment[]
  billingServicePrices         ClientBillingService[]
  fbsBillingSettings           ClientFbsBillingSettings?
  deliveryRequests             LogisticsDeliveryRequest[]
  requestFiles                 ClientRequestFile[]
  requestPackages              ClientRequestPackage[]
  notifications                ClientNotification[]
  notificationPreferences      ClientNotificationPreference[]
  marketplaceConnections       ClientMarketplaceConnection[]
  dbsIntegrations              ClientDbsIntegration[]
  fbsSupplyPlans               FbsSupplyPlan[]
  fbsStockPublications         FbsStockPublication[]
  // ADDED: Per-cabinet WB stock distribution without mixing physical client balances.
  fbsStockAllocationPolicies   FbsStockAllocationPolicy[]
  fbsStockIntegrationApiKeys   FbsStockIntegrationApiKey[]
  fbsStockAllocationChanges    FbsStockAllocationChange[]
  ozonFboPlans                 OzonFboPlan[]
  articleMappings              ClientArticleMapping[]
  allowedIps                   ClientAllowedIp[]
  productMarks                 ProductMark[]
  warehouseLinks               WarehouseClient[]
  warehouseTransfers           InterWarehouseTransfer[]
  referralUsers                UserReferralClient[]
  requestComments              ClientRequestComment[]
  requestEvents                ClientRequestEvent[]
  contracts                    ClientContract[]
  expenseEntries               ExpenseEntry[]
  expenseMaterialRules         ClientExpenseMaterialRule[]
  expenseMaterialMovements     ExpenseMaterialMovement[]
  factoryShipments             FactoryShipment[]
  kizTrueApiConnection         KizTrueApiConnection?
  kizCirculationItems          KizCirculationItem[]
  kizCirculationBatches        KizCirculationBatch[]
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt

  @@index([fulfillmentManagerUserId])
  @@index([ownCompanyId])
}

model UserSession {
  id            String    @id @default(uuid())
  userId        String
  accessTokenId String?   @unique
  ipAddress     String?
  userAgent     String?
  appName       String    @default("WMS")
  browserName   String    @default("Unknown")
  startedAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([userId, lastSeenAt])
  @@index([expiresAt])
}

model ClientAllowedIp {
  id        String   @id @default(uuid())
  clientId  String
  ipAddress String
  comment   String?
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, ipAddress])
  @@index([clientId])
}

model ClientArticleMapping {
  id            String   @id @default(uuid())
  clientId      String
  sourceArticle String
  targetArticle String
  comment       String?
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([clientId, sourceArticle, targetArticle])
  @@index([clientId, targetArticle])
  @@index([clientId, sourceArticle])
}

model ClientMarketplaceConnection {
  id                        String                    @id @default(uuid())
  clientId                  String
  marketplace               MarketplaceType
  accountName               String?
  sellerId                  String?
  apiKey                    String
  isActive                  Boolean                   @default(true)
  comment                   String?
  fbsWarehouseId            String?
  fbsWarehouseName          String?
  fbsWarehouseConnectedAt   DateTime?
  fbsExecutionWarehouseId   String?
  fbsDropoffWarehouseId     String?
  fbsAutoRouteNewWarehouses Boolean                   @default(false)
  client                    Client                    @relation(fields: [clientId], references: [id])
  fbsExecutionWarehouse     Warehouse?                @relation("FbsExecutionWarehouse", fields: [fbsExecutionWarehouseId], references: [id], onDelete: SetNull)
  fbsDropoffWarehouse       Warehouse?                @relation("FbsDropoffWarehouse", fields: [fbsDropoffWarehouseId], references: [id], onDelete: SetNull)
  fbsStockPublications      FbsStockPublication[]
  fbsStockAllocationPolicy  FbsStockAllocationPolicy?
  fbsWarehouseRoutes        FbsWarehouseRoutingRule[]
  ozonFboPlans              OzonFboPlan[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@unique([clientId, marketplace, accountName])
  @@index([clientId])
}

model ClientDbsIntegration {
  id                  String          @id @default(uuid())
  clientId            String
  marketplace         MarketplaceType
  senderName          String
  contactName         String?
  phone               String
  email               String?
  city                String
  address             String
  postalCode          String?
  deliveryProvider    String
  deliveryServiceName String?
  deliveryApiUrl      String?
  deliveryAccountId   String?
  deliveryApiKey      String
  deliveryApiSecret   String?
  isActive            Boolean         @default(true)
  lastCheckedAt       DateTime?
  lastCheckOk         Boolean?
  lastCheckMessage    String?
  client              Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([clientId, marketplace])
  @@index([clientId, isActive])
  @@index([marketplace, isActive])
}

model Warehouse {
  id                      String                        @id @default(uuid())
  code                    String                        @unique
  name                    String
  city                    String                        @default("Москва")
  address                 String?
  ownCompanyId            String?
  isActive                Boolean                       @default(true)
  sortOrder               Int                           @default(100)
  ownCompany              OwnCompany?                   @relation("WarehouseDefaultOwnCompany", fields: [ownCompanyId], references: [id], onDelete: SetNull)
  ownedCompanies          OwnCompany[]                  @relation("WarehouseScopedOwnCompanies")
  zones                   Zone[]
  storagePallets          StoragePallet[]
  boxes                   Box[]
  requests                ClientRequest[]
  contracts               ClientContract[]
  activeUsers             User[]                        @relation("ActiveWarehouse")
  userScopes              UserWarehouse[]
  clients                 WarehouseClient[]
  outboundTransfers       InterWarehouseTransfer[]      @relation("TransferFromWarehouse")
  inboundTransfers        InterWarehouseTransfer[]      @relation("TransferToWarehouse")
  stockMovements          StockMovement[]
  stockBalances           StockBalance[]
  billingInvoices         BillingInvoice[]
  inventorySessions       InventorySession[]            @relation("InventorySessionWarehouse")
  pickWaves               PickWave[]
  inventoryRescanRequests InventoryBoxRescanRequest[]    @relation("InventoryRescanWarehouse")
  boxIntegrityChecks      WarehouseBoxCheck[]            @relation("WarehouseBoxIntegrityChecks")
  boxIntegrityRows        WarehouseBoxCheckRow[]         @relation("WarehouseBoxIntegrityRows")
  shippedKizHistory       ShippedKizHistory[]            @relation("WarehouseShippedKizHistory")
  logisticsDeliveries     LogisticsDeliveryRequest[]     @relation("WarehouseLogisticsDeliveries")
  fbsExecutionConnections ClientMarketplaceConnection[] @relation("FbsExecutionWarehouse")
  fbsDropoffConnections   ClientMarketplaceConnection[] @relation("FbsDropoffWarehouse")
  fbsRouteExecutions      FbsWarehouseRoutingRule[]     @relation("FbsRouteExecutionWarehouse")
  fbsRouteDropoffs        FbsWarehouseRoutingRule[]     @relation("FbsRouteDropoffWarehouse")
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @default(now()) @updatedAt

  @@index([city, isActive])
  @@index([ownCompanyId])
}

model FbsWarehouseRoutingRule {
  id                       String                      @id @default(uuid())
  connectionId             String
  marketplaceWarehouseId   String
  marketplaceWarehouseName String?
  officeId                 String?
  officeName               String?
  officeCity               String?
  mode                     String                      @default("CENTRAL")
  executionWarehouseId     String?
  dropoffWarehouseId       String?
  connection               ClientMarketplaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  executionWarehouse       Warehouse?                  @relation("FbsRouteExecutionWarehouse", fields: [executionWarehouseId], references: [id], onDelete: SetNull)
  dropoffWarehouse         Warehouse?                  @relation("FbsRouteDropoffWarehouse", fields: [dropoffWarehouseId], references: [id], onDelete: SetNull)
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@unique([connectionId, marketplaceWarehouseId])
  @@index([connectionId, mode])
  @@index([executionWarehouseId])
  @@index([dropoffWarehouseId])
}

model UserWarehouse {
  userId        String
  warehouseId   String
  canRead       Boolean   @default(true)
  canWrite      Boolean   @default(false)
  isResponsible Boolean   @default(false)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@id([userId, warehouseId])
  @@index([warehouseId])
  @@index([warehouseId, isResponsible])
}

model WarehouseClient {
  warehouseId           String
  clientId              String
  activatedByTransferId String?
  status                String    @default("ACTIVE")
  source                String    @default("LOCAL")
  activatedAt           DateTime?
  warehouse             Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  client                Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@id([warehouseId, clientId])
  @@index([clientId])
  @@index([warehouseId, status])
}

model InterWarehouseTransfer {
  id                 String                        @id @default(uuid())
  number             Int                           @unique @default(autoincrement())
  clientId           String
  fromWarehouseId    String
  toWarehouseId      String
  status             String                        @default("PENDING_RECEIPT")
  transferMode       String                        @default("ITEMS")
  items              Json
  manifest           Json?
  totalQuantity      Int
  sourceBoxCodes     Json?
  receivedBoxCodes   Json?
  destinationBoxCode String?
  receivedQuantity   Int                           @default(0)
  comment            String?
  createdByUserId    String
  createdByName      String
  receivedByUserId   String?
  receivedByName     String?
  dispatchedAt       DateTime?
