  @@index([enabled, lastSeenAt])
}

model FbsPrintJob {
  id              String            @id @default(uuid())
  stationId       String
  station         FbsPrintStation   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  historyId       String            @unique
  assemblyId      String
  requestId       String
  requestNumber   Int?
  orderId         String
  kiz             String
  warehouseName   String
  productName     String?
  stickerCode     String?
  stickerMime     String            @default("image/png")
  stickerBase64   String
  status          FbsPrintJobStatus @default(QUEUED)
  attempts        Int               @default(0)
  source          String            @default("TSD_FBS_ASSEMBLY")
  requestedById   String
  requestedBy     String
  deviceCode      String?
  claimedAt       DateTime?
  printedAt       DateTime?
  failedAt        DateTime?
  errorMessage    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([stationId, status, createdAt])
  @@index([requestId, createdAt])
  @@index([orderId])
}

model BillingCharge {
  id               String                     @id @default(uuid())
  clientId         String
  serviceId        String?
  requestId        String?
  description      String
  unit             BillingUnit                @default(SERVICE)
  quantity         Decimal                    @db.Decimal(12, 3)
  unitPriceRub     Decimal                    @db.Decimal(12, 2)
  totalRub         Decimal                    @db.Decimal(14, 2)
  status           BillingChargeStatus        @default(DRAFT)
  serviceDate      DateTime                   @default(now())
  source           BillingChargeSource        @default(MANUAL)
  sourceKey        String?                    @unique
  metadata         Json?
  comment          String?
  createdByUserId  String?
  approvedByUserId String?
  approvedAt       DateTime?
  client           Client                     @relation(fields: [clientId], references: [id])
  service          BillingService?            @relation(fields: [serviceId], references: [id])
  request          ClientRequest?             @relation(fields: [requestId], references: [id])
  createdBy        User?                      @relation("BillingChargeCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy       User?                      @relation("BillingChargeApprovedBy", fields: [approvedByUserId], references: [id])
  invoiceItems     BillingInvoiceItem[]
  deliveryRequests LogisticsDeliveryRequest[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([clientId, status, serviceDate])
  @@index([requestId])
  @@index([serviceId])
  @@index([approvedByUserId])
  @@index([source, serviceDate])
}

model BillingInvoice {
  id                          String               @id @default(uuid())
  warehouseId                 String?
  number                      String               @unique
  clientId                    String
  periodFrom                  DateTime
  periodTo                    DateTime
  dueDate                     DateTime?
  status                      BillingInvoiceStatus @default(DRAFT)
  source                      BillingInvoiceSource @default(MANUAL)
  sourceKey                   String?              @unique
  requestId                   String?
  totalRub                    Decimal              @db.Decimal(14, 2)
  paidRub                     Decimal              @default(0) @db.Decimal(14, 2)
  issuedAt                    DateTime?
  paidAt                      DateTime?
  comment                     String?
  paymentBankAccountId        String?
  paymentBankName             String?
  paymentBankBik              String?
  paymentBankInn              String?
  paymentBankKpp              String?
  paymentBankAccount          String?
  paymentCorrespondentAccount String?
  createdByUserId             String?
  client                      Client               @relation(fields: [clientId], references: [id])
  warehouse                   Warehouse?            @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  request                     ClientRequest?       @relation(fields: [requestId], references: [id])
  createdBy                   User?                @relation("BillingInvoiceCreatedBy", fields: [createdByUserId], references: [id])
  items                       BillingInvoiceItem[]
  payments                    BillingPayment[]
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  @@index([clientId, status, periodFrom])
  @@index([warehouseId, periodFrom])
  @@index([periodTo])
  @@index([requestId])
  @@index([source, periodFrom])
  @@index([createdByUserId])
  @@index([paymentBankAccountId])
}

model BillingInvoiceItem {
  id           String         @id @default(uuid())
  invoiceId    String
  chargeId     String?
  description  String
  unit         BillingUnit    @default(SERVICE)
  quantity     Decimal        @db.Decimal(12, 3)
  unitPriceRub Decimal        @db.Decimal(12, 2)
  totalRub     Decimal        @db.Decimal(14, 2)
  serviceDate  DateTime
  invoice      BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  charge       BillingCharge? @relation(fields: [chargeId], references: [id])

  @@index([invoiceId])
  @@index([chargeId])
}

model BillingPayment {
  id              String               @id @default(uuid())
  invoiceId       String?
  clientId        String
  amountRub       Decimal              @db.Decimal(14, 2)
  paidAt          DateTime             @default(now())
  method          String?
  reference       String?
  comment         String?
  status          BillingPaymentStatus @default(RECORDED)
  createdByUserId String?
  invoice         BillingInvoice?      @relation(fields: [invoiceId], references: [id])
  client          Client               @relation(fields: [clientId], references: [id])
  createdBy       User?                @relation("BillingPaymentCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([invoiceId, status])
  @@index([clientId, paidAt])
  @@index([createdByUserId])
}

model ExpenseMaterial {
  id                 String                      @id @default(uuid())
  code               String                      @unique
  name               String
  unit               String                      @default("шт.")
  stockQuantity      Decimal                     @default(0) @db.Decimal(14, 3)
  averageUnitCostRub Decimal                     @default(0) @db.Decimal(14, 4)
  minStockQuantity   Decimal                     @default(0) @db.Decimal(14, 3)
  isActive           Boolean                     @default(true)
  comment            String?
  rules              ClientExpenseMaterialRule[]
  movements          ExpenseMaterialMovement[]
  expenseEntries     ExpenseEntry[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([isActive, name])
}

model ClientExpenseMaterialRule {
  id                     String          @id @default(uuid())
  clientId               String
  materialId             String
  isEnabled              Boolean         @default(true)
  quantityPerShippedUnit Decimal         @default(1) @db.Decimal(12, 3)
  chargeSeparately       Boolean         @default(false)
  billingUnitPriceRub    Decimal?        @db.Decimal(12, 2)
  comment                String?
  updatedByUserId        String?
  client                 Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  material               ExpenseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  updatedBy              User?           @relation("ClientExpenseMaterialRuleUpdatedBy", fields: [updatedByUserId], references: [id])
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([clientId, materialId])
  @@index([clientId, isEnabled])
  @@index([materialId])
  @@index([updatedByUserId])
}

model ExpenseEntry {
  id                String                   @id @default(uuid())
  category          ExpenseCategory
  source            ExpenseSource            @default(MANUAL)
  status            ExpenseStatus            @default(ACTIVE)
  expenseDate       DateTime                 @default(now())
  amountRub         Decimal                  @db.Decimal(14, 2)
  description       String
  clientId          String?
  requestId         String?
  materialId        String?
  quantity          Decimal?                 @db.Decimal(14, 3)
  unit              String?
  unitPriceRub      Decimal?                 @db.Decimal(14, 4)
  workerName        String?
  sourceKey         String?                  @unique
  comment           String?
  createdByUserId   String?
  cancelledByUserId String?
  cancelledAt       DateTime?
  client            Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  request           ClientRequest?           @relation(fields: [requestId], references: [id], onDelete: SetNull)
  material          ExpenseMaterial?         @relation(fields: [materialId], references: [id], onDelete: SetNull)
  createdBy         User?                    @relation("ExpenseEntryCreatedBy", fields: [createdByUserId], references: [id])
  cancelledBy       User?                    @relation("ExpenseEntryCancelledBy", fields: [cancelledByUserId], references: [id])
  materialMovement  ExpenseMaterialMovement?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([expenseDate, category, status])
  @@index([clientId, expenseDate])
  @@index([requestId])
  @@index([materialId])
  @@index([createdByUserId])
}

model ExpenseMaterialMovement {
  id              String                      @id @default(uuid())
  materialId      String
  type            ExpenseMaterialMovementType
  quantity        Decimal                     @db.Decimal(14, 3)
  unitCostRub     Decimal?                    @db.Decimal(14, 4)
  clientId        String?
  requestId       String?
  expenseEntryId  String?                     @unique
  sourceKey       String?                     @unique
  comment         String?
  createdByUserId String?
  material        ExpenseMaterial             @relation(fields: [materialId], references: [id], onDelete: Cascade)
  client          Client?                     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  request         ClientRequest?              @relation(fields: [requestId], references: [id], onDelete: SetNull)
  expenseEntry    ExpenseEntry?               @relation(fields: [expenseEntryId], references: [id], onDelete: SetNull)
  createdBy       User?                       @relation("ExpenseMaterialMovementCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime                    @default(now())

  @@index([materialId, createdAt])
  @@index([clientId, createdAt])
  @@index([requestId])
  @@index([createdByUserId])
}

model OwnCompany {
  id                   String                  @id @default(uuid())
  warehouseId          String?
  shortName            String
  fullName             String
  inn                  String
  kpp                  String?
  ogrn                 String?
  legalAddress         String?
  bankName             String?
  bankBik              String?
  bankAccount          String?
  correspondentAccount String?
  paymentCode          String?
  paymentPurposeCode   String?
  isDefault            Boolean                 @default(false)
  isActive             Boolean                 @default(true)
  comment              String?
  stampFileName        String?
  stampMimeType        String?
  stampData            Bytes?
  signatureFileName    String?
  signatureMimeType    String?
  signatureData        Bytes?
  bankAccounts         OwnCompanyBankAccount[]
  clients              Client[]
  warehouse            Warehouse?              @relation("WarehouseScopedOwnCompanies", fields: [warehouseId], references: [id], onDelete: SetNull)
  warehouses           Warehouse[]             @relation("WarehouseDefaultOwnCompany")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([isDefault, isActive])
  @@index([inn])
  @@index([warehouseId, isActive])
}

model OwnCompanyBankAccount {
  id                   String     @id @default(uuid())
  companyId            String
  bankName             String
  bankBik              String
  bankInn              String?
  bankKpp              String?
  bankAccount          String
  correspondentAccount String?
  isDefault            Boolean    @default(false)
  comment              String?
  company              OwnCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([companyId])
}

model ClientContract {
  id                     String                     @id @default(uuid())
  number                 String                     @unique
  clientId               String
  warehouseId            String?
  contractDate           DateTime                   @db.Date
  fileName               String
  contentType            String                     @default("application/pdf")
  fileSize               Int
  pdfData                Bytes
  signedFileName         String?
  signedFileSize         Int?
  signedPdfData          Bytes?
  signedUploadedAt       DateTime?
  signedUploadedByUserId String?
  wmsUrl                 String
  wmsLogin               String
  clientSnapshot         Json
  executorSnapshot       Json
  createdByUserId        String?
  client                 Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  warehouse              Warehouse?                 @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdBy              User?                      @relation("ClientContractCreatedBy", fields: [createdByUserId], references: [id])
  signedUploadedBy       User?                      @relation("ClientContractSignedUploadedBy", fields: [signedUploadedByUserId], references: [id])
  attachments            ClientContractAttachment[]
  archivedAt             DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([clientId, contractDate])
  @@index([warehouseId, contractDate])
  @@index([createdByUserId])
  @@index([signedUploadedByUserId])
  @@index([archivedAt])
}

model ClientContractAttachment {
  id               String         @id @default(uuid())
  contractId       String
  fileName         String
  contentType      String         @default("application/pdf")
  fileSize         Int
  pdfData          Bytes
  uploadedByUserId String?
  contract         ClientContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedBy       User?          @relation("ClientContractAttachmentUploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime       @default(now())

  @@index([contractId, createdAt])
  @@index([uploadedByUserId])
}

model LogisticsTariffSet {
  id               String                     @id @default(uuid())
  name             String
  sourceFile       String?
  note             String?
  activeFrom       DateTime?
  activeTo         DateTime?
  directions       LogisticsDirection[]
  deliveryRequests LogisticsDeliveryRequest[]
  createdAt        DateTime                   @default(now())
}

model LogisticsDirection {
  id          String               @id @default(uuid())
  tariffSetId String
  origin      String
  destination String
  note        String?
  pricingMode LogisticsPricingMode @default(MANUAL_REVIEW)
  tariffSet   LogisticsTariffSet   @relation(fields: [tariffSetId], references: [id])
  tiers       LogisticsRateTier[]

  @@index([tariffSetId, origin, destination])
}

model LogisticsRateTier {
  id          String               @id @default(uuid())
  directionId String
  label       String
  minPallets  Int?
  maxPallets  Int?
  maxBoxes    Int?
  pricingMode LogisticsPricingMode @default(MANUAL_REVIEW)
  priceRub    Decimal              @db.Decimal(12, 2)
  direction   LogisticsDirection   @relation(fields: [directionId], references: [id])

  @@index([directionId])
}

model LogisticsCarrier {
  id          String          @id @default(uuid())
  name        String
  phone       String?
  contactName String?
  comment     String?
  isActive    Boolean         @default(true)
  trips       LogisticsTrip[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isActive, name])
}

model LogisticsTrip {
  id            String                     @id @default(uuid())
  code          String                     @unique
  carrierId     String?
  plannedDate   DateTime?
  vehicleNumber String?
  driverName    String?
  driverPhone   String?
  status        LogisticsTripStatus        @default(PLANNED)
  comment       String?
  carrier       LogisticsCarrier?          @relation(fields: [carrierId], references: [id])
  deliveries    LogisticsDeliveryRequest[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([status, plannedDate])
  @@index([carrierId])
}

model LogisticsDeliveryRequest {
  id                   String                  @id @default(uuid())
  clientId             String
  warehouseId          String?
  requestId            String?
  tariffSetId          String?
  billingChargeId      String?
  tripId               String?
  origin               String
  destination          String
  boxes                Int?
  pallets              Int?
  desiredShipDate      DateTime?
  plannedShipDate      DateTime?
  status               LogisticsDeliveryStatus @default(REQUESTED)
  estimatedTotalRub    Decimal?                @db.Decimal(14, 2)
  requiresManualReview Boolean                 @default(false)
  comment              String?
  managerComment       String?
  createdByUserId      String?
  client               Client                  @relation(fields: [clientId], references: [id])
  warehouse            Warehouse?              @relation("WarehouseLogisticsDeliveries", fields: [warehouseId], references: [id], onDelete: SetNull)
  request              ClientRequest?          @relation(fields: [requestId], references: [id])
  tariffSet            LogisticsTariffSet?     @relation(fields: [tariffSetId], references: [id])
  billingCharge        BillingCharge?          @relation(fields: [billingChargeId], references: [id])
  trip                 LogisticsTrip?          @relation(fields: [tripId], references: [id])
  createdBy            User?                   @relation("LogisticsDeliveryCreatedBy", fields: [createdByUserId], references: [id])
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([clientId, status, createdAt])
  @@index([warehouseId, status, createdAt])
  @@index([requestId])
  @@index([billingChargeId])
  @@index([tariffSetId])
  @@index([tripId])
}

model TsdOperation {
  id                String             @id @default(uuid())
  deviceId          String
  operationKey      String             @unique
  operationType     String
  payload           Json
  status            TsdOperationStatus @default(ACCEPTED)
  serverMessage     String?
  reviewReason      TsdReviewReason?
  resolutionMessage String?
  reviewAction      TsdReviewAction?
  reviewComment     String?
  reviewedByUserId  String?
  reviewedBy        User?              @relation("TsdOperationReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([deviceId])
  @@index([reviewReason])
  @@index([reviewedAt])
  @@index([reviewedByUserId])
}

model TsdDevice {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  secretHash  String
  status      TsdDeviceStatus @default(ACTIVE)
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  lastLoginAt DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model PrintJob {
  id          String    @id @default(uuid())
  printerCode String
  labelType   String
  payload     Json
  tspl        String
  status      String    @default("queued")
  attempts    Int       @default(0)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([printerCode, status, createdAt])
}

model PrintPrinter {
  id             String    @id @default(uuid())
  code           String    @unique
  groupCode      String    @default("DEFAULT")
  name           String
  connectionType String    @default("dry_run")
  host           String?
  port           Int?
  isActive       Boolean   @default(true)
  autoProcess    Boolean   @default(true)
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([groupCode, isActive, autoProcess])
  @@index([isActive, autoProcess])
}

model LabelTemplate {
  id          String                 @id @default(uuid())
  code        String                 @unique
  name        String
  type        LabelTemplateType
  description String?
  widthMm     Int                    @default(80)
  heightMm    Int                    @default(50)
  tspl        String
  version     Int                    @default(1)
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  versions    LabelTemplateVersion[]

  @@index([type, isActive])
}

model LabelTemplateVersion {
  id           String            @id @default(uuid())
  templateId   String
  version      Int
  code         String
  name         String
  type         LabelTemplateType
  description  String?
  widthMm      Int
  heightMm     Int
  tspl         String
  isActive     Boolean
  changeReason String?
  createdAt    DateTime          @default(now())
  template     LabelTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  payload   Json?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
