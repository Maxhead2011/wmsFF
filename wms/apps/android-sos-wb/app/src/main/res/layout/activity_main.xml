<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F4F6FA">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="650dp" android:orientation="vertical" android:padding="18dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SOS WB" android:textSize="42sp" android:textStyle="bold" android:textColor="#D9112B" android:gravity="center"/>
    <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Аварийная сборка и печать Wildberries" android:textSize="15sp" android:textColor="#4A5568" android:gravity="center" android:layout_marginBottom="14dp"/>
    <EditText android:id="@+id/login" android:layout_width="match_parent" android:layout_height="58dp" android:hint="Логин WMS" android:singleLine="true"/>
    <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="58dp" android:hint="Пароль" android:inputType="textPassword" android:singleLine="true"/>
    <Button android:id="@+id/loginButton" android:layout_width="match_parent" android:layout_height="64dp" android:text="ВОЙТИ" android:textSize="18sp"/>
    <TextView android:id="@+id/modeLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="РЕЖИМ РАБОТЫ" android:textStyle="bold" android:layout_marginTop="12dp" android:visibility="gone"/>
    <LinearLayout android:id="@+id/modeButtons" android:layout_width="match_parent" android:layout_height="68dp" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:visibility="gone">
      <Button android:id="@+id/modeRequestButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:text="ПО ЗАЯВКЕ" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/sos_mode_button_text" android:background="@drawable/sos_mode_button" android:backgroundTint="@null" android:elevation="4dp" android:minHeight="52dp" android:minWidth="0dp" android:paddingStart="5dp" android:paddingEnd="5dp"/>
      <Button android:id="@+id/modeAllButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:text="ВСЕ ЗАЯВКИ" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/sos_mode_button_text" android:background="@drawable/sos_mode_button" android:backgroundTint="@null" android:elevation="4dp" android:minHeight="52dp" android:minWidth="0dp" android:paddingStart="5dp" android:paddingEnd="5dp"/>
      <Button android:id="@+id/modePrintButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginStart="5dp" android:text="ПЕЧАТЬ WB" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/sos_mode_button_text" android:background="@drawable/sos_mode_button" android:backgroundTint="@null" android:elevation="4dp" android:minHeight="52dp" android:minWidth="0dp" android:paddingStart="5dp" android:paddingEnd="5dp"/>
    </LinearLayout>
    <Button android:id="@+id/modeBoxButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="8dp" android:text="КОРОБ + ТОВАР" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/sos_mode_button_text" android:background="@drawable/sos_mode_button" android:backgroundTint="@null" android:elevation="4dp" android:visibility="gone"/>
    <Spinner android:id="@+id/mode" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/requestLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ЗАЯВКА WMS" android:textStyle="bold" android:layout_marginTop="8dp" android:visibility="gone"/>
    <Spinner android:id="@+id/request" android:layout_width="match_parent" android:layout_height="60dp" android:visibility="gone"/>
    <TextView android:id="@+id/stationLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ПЕЧАТНАЯ СТАНЦИЯ" android:textStyle="bold" android:layout_marginTop="8dp" android:visibility="gone"/>
    <Spinner android:id="@+id/station" android:layout_width="match_parent" android:layout_height="60dp" android:visibility="gone"/>
    <TextView android:id="@+id/requestNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="46sp" android:textStyle="bold" android:textColor="#FFFFFF" android:gravity="center" android:visibility="gone"/>
    <TextView android:id="@+id/orderNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="30sp" android:textStyle="bold" android:textColor="#FFFFFF" android:gravity="center" android:visibility="gone"/>
    <TextView android:id="@+id/prompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ОТСКАНИРУЙТЕ ШК КОСТЮМА" android:textSize="25sp" android:textStyle="bold" android:textColor="#111827" android:gravity="center" android:padding="14dp" android:visibility="gone"/>
    <EditText android:id="@+id/code" android:layout_width="match_parent" android:layout_height="74dp" android:hint="Поле сканера" android:textSize="20sp" android:singleLine="true" android:visibility="gone"/>
    <Button android:id="@+id/cancelButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="ОТМЕНИТЬ ВЫБОР ЗАКАЗА" android:visibility="gone"/>
    <Button android:id="@+id/replaceButton" android:layout_width="match_parent" android:layout_height="64dp" android:text="ЗАМЕНИТЬ КИЗ В WB" android:textStyle="bold" android:backgroundTint="#F5A000" android:visibility="gone"/>
    <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="16dp" android:textSize="20sp" android:textStyle="bold" android:text="Войдите под пользователем WMS."/>
  </LinearLayout>
</ScrollView>
