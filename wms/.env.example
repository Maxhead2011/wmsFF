# Общие настройки WMS. Реальные секреты не коммитим.
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173

POSTGRES_DB=wms
POSTGRES_USER=wms
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://wms:change_me@postgres:5432/wms?schema=public

ANALYTICS_POSTGRES_DB=logoff_analytics
ANALYTICS_POSTGRES_USER=logoff_analytics
ANALYTICS_POSTGRES_PASSWORD=change_me_analytics
ANALYTICS_DATABASE_URL=postgresql://logoff_analytics:change_me_analytics@analytics-postgres:5432/logoff_analytics?schema=public
ANALYTICS_CREDENTIALS_SECRET=change_me_analytics_credentials
ANALYTICS_AUTO_SYNC_ENABLED=true
ANALYTICS_AUTO_SYNC_INITIAL_DELAY_MS=300000
ANALYTICS_AUTO_SYNC_INTERVAL_MS=1800000
ANALYTICS_AUTO_SYNC_FAILED_RETRY_MS=600000

REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
BOOTSTRAP_ADMIN_SECRET=change_me_bootstrap
FIREBASE_SERVICE_ACCOUNT_JSON=

PUBLIC_API_URL=https://wms.logoff.pro/api/v1
VITE_API_URL=/api/v1

DEFAULT_PRINTER_CODE=TSC-01
DEFAULT_PRINTER_NAME=TSC dry-run
PRINT_WORKER_INTERVAL_MS=5000
PRINT_WORKER_DISABLED=false
# FIX: enable only on our LOGOFF WMS after installing a compatible TSD build.
# false preserves the sold installation's SKU collection workflow.
WMS_SKU_SORTING_ENABLED=false
# FIX: optional one-device, one-existing-request pilot. Both IDs are required; global mode stays false.
WMS_SKU_SORTING_PILOT_DEVICE_ID=
WMS_SKU_SORTING_PILOT_REQUEST_ID=
# FIX: WMSFF2207 only. Preserve configured storage boxes and detach picked/shipped KIZs from source storage.
# Does not restore previously archived boxes or change existing stock. Keep false in sold WMS.
WMS_PERMANENT_STORAGE_BOXES_ENABLED=false
# FIX: enable on our WMS so employee deletion revokes access without blocking shared TSDs.
# Deliberate administrator device blocks remain unchanged. Keep false in sold WMS.
WMS_USER_DELETION_PRESERVE_TSD_DEVICES=false
# FIX: enable on our WMS to reject unknown FBS KIZs when stock is fully marked.
# Never overwrite another unit's KIZ. Keep false in sold WMS for compatibility.
WMS_FBS_PRESERVE_STOCK_KIZ=false
# FIX: opt-in LOGOFF TSD transition to physical box audit on a stock/KIZ discrepancy.
WMS_FBS_KIZ_MANDATORY_AUDIT=false
# FIX: administrator-confirmed physical returns during inventory; enable only on our WMS.
WMS_INVENTORY_SCANNED_RETURN_ENABLED=false
# FIX: accept scanned SKU and consolidate duplicate identities on ADMIN/OWNER confirmation only.
WMS_INVENTORY_ADMIN_KIZ_RECONCILE_ENABLED=false
# FIX: explicit confirmation of an incorrectly paired scan during an open count.
WMS_INVENTORY_SCAN_CORRECTION_ENABLED=false

# FIX: read-only KIZ location lookup for ADMIN/OWNER/SUPER_ADMIN in our installation.
WMS_KIZ_LOCATION_CHECK_ENABLED=false

# FIX: our WMS only; requires the additive FBO migration, web and updated LOGOFF TSD.
# Leave disabled in sold installations. Do not disable while an FBO assembly is active.
WMS_FBO_TWO_STAGE_ENABLED=false
# FIX: enable compact FBO receipts only on our WMS after deploying compatible TSD clients.
WMS_FBO_FAST_ACK_ENABLED=false
# FIX: enrich Ozon FBS orders with physical catalog barcodes in our WMS only.
WMS_OZON_FBS_CATALOG_BARCODES=false
# FIX: opt-in only after migration, reservation backfill and lifecycle verification.
WMS_WB_ORDER_STOCK_LIFECYCLE_ENABLED=false

# FIX: keep large audit responses out of the TSD monitor read path.
WMS_TSD_MONITOR_COMPACT_ENABLED=false
## Our VM only: deduplicate FBS source calculations and request hydration.
WMS_FBS_CALCULATION_FAST_ENABLED=false
