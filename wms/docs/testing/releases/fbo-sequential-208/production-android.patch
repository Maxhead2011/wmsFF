+    }
+
+    public boolean hasRole(String roleCode) {
+        if (roleCode == null) {
+            return false;
+        }
+        for (String assignedRole : roleCodes) {
+            if (roleCode.equalsIgnoreCase(assignedRole)) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
